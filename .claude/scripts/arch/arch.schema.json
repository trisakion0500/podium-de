{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "arch-ir",
  "title": "Architecture IR",
  "description": "현재 시점 코드 구조를 기술하는 중간 표현. 이전 구조/변경 이력은 다루지 않는다.",
  "type": "object",
  "required": ["commit", "generatedAt", "boundaries", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "산출물 파일명(확장자 제외)"
    },
    "commit": {
      "type": "string",
      "description": "git rev-parse --short HEAD 결과"
    },
    "generatedAt": {
      "type": "string",
      "description": "ISO 8601 타임스탬프"
    },
    "boundaries": {
      "type": "array",
      "description": "바운디드 컨텍스트/레이어 그룹. 다이어그램의 스윔레인 단위",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "boundary", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "entrypoint",
              "route",
              "service",
              "repository",
              "external",
              "infra",
              "env",
              "context",
              "other"
            ]
          },
          "boundary": {
            "type": "string",
            "description": "boundaries[].id 참조"
          },
          "evidence": {
            "type": "object",
            "required": ["file"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "lineStart": { "type": "integer", "minimum": 1 },
              "lineEnd": { "type": "integer", "minimum": 1 }
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["confirmed", "weak"],
            "description": "weak면 보고서에 🟡로 표시됨. 생략 시 confirmed"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "description": "nodes[].id 참조" },
          "to": { "type": "string", "description": "nodes[].id 참조" },
          "label": { "type": "string" }
        }
      }
    },
    "excluded": {
      "type": "array",
      "description": "범위에서 제외한 것과 이유",
      "items": {
        "type": "object",
        "required": ["what", "why"],
        "additionalProperties": false,
        "properties": {
          "what": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    }
  }
}
