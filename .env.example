# MySQL (podium_de, podium_de_log 스키마와 두 계정은 미리 생성: docs/03_DEV_SETUP.md 참고)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=podium_de
DB_POOL_SIZE=10

# 앱 계정 (API·워커). podium_de EXECUTE만 — SP로만 접근한다
DB_APP_USER=podium_app
DB_APP_PASSWORD=your_app_password

# migrate 계정 (npm run migrate, npm run upgrade). 스키마 전체 권한과 PROCESS, SP DEFINER
# API·워커만 실행하는 호스트에는 두지 않는다.
DB_MIGRATE_USER=podium_migrate
DB_MIGRATE_PASSWORD=your_migrate_password

# 로그 DB (제출 이력, D-48). 메인과 물리적으로 분리된 DB — 접속 정보는 필수이며 메인 값으로 대체하지 않는다.
# 로컬은 같은 MySQL의 podium_de_log와 같은 계정을 써도 된다.
DB_LOG_HOST=127.0.0.1
DB_LOG_PORT=3306
DB_LOG_NAME=podium_de_log
DB_LOG_POOL_SIZE=5

# 로그 DB 앱 계정 (API·워커). podium_de_log EXECUTE만
DB_LOG_APP_USER=podium_app
DB_LOG_APP_PASSWORD=your_app_password

# 로그 DB migrate 계정 (npm run migrate, npm run upgrade). podium_de_log 전체 권한, SP DEFINER
# API·워커만 실행하는 호스트에는 두지 않는다.
DB_LOG_MIGRATE_USER=podium_migrate
DB_LOG_MIGRATE_PASSWORD=your_migrate_password

# 제출 이력 보관 일수
LOG_RETENTION_DAYS=90

# API 프로세스
API_PORT=3000
# 수신 주소. 기본 ::(IPv6+IPv4). IPv6가 꺼진 호스트만 0.0.0.0
API_HOST=::
# 요청 처리 제한 시간(ms). 넘으면 타임아웃 응답(2005)만 보내고 진행 중인 DB 작업은 계속된다
API_TIMEOUT_MS=30000
# 1이면 Swagger UI(/docs)를 연다. 운영 환경은 0(기본)
API_DOCS=1

# Redis 실시간 순위표. 원장은 MySQL이라 Redis가 없어도 API는 뜨고 제출은 성공한다(빠진 반영은 워커 복구 잡이 채움)
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
# 모든 키 앞에 붙는 접두어. Redis를 다른 서비스와 함께 쓸 때 지정 (예: ped:)
REDIS_KEY_PREFIX=
# 명령 하나의 제한 시간(ms). 넘으면 Redis 반영을 실패로 보고 응답을 진행한다
REDIS_TIMEOUT_MS=500

# 워커 복구 잡 (리컨실러·재구축). 주기(ms), 동기화 시각 안전마진(초, 최대 트랜잭션 시간보다 길게), 한 번에 읽는 행 수
RECOVERY_INTERVAL_MS=5000
RECOVERY_MARGIN_SEC=60
RECOVERY_CHUNK=1000

# npm run upgrade (중단 패치: 중지 → migrate → 기동 → 새 버전 하트비트 확인)
# 명령은 셸로 실행한다. 아래 예시 중 하나를 골라 주석을 푼다. 두 명령이 없으면 upgrade는 아무것도 멈추지 않고 오류(종료 코드 1)로 끝난다.
#
# pm2 예시 (최초 1회 등록: README 참고)
# UPGRADE_STOP_CMD=pm2 stop podium-api podium-worker
# UPGRADE_START_CMD=pm2 start podium-api podium-worker
#
# 직접 실행 예시 (Linux). 시작 명령은 백그라운드로 띄우고 출력을 파일로 돌린다.
# UPGRADE_STOP_CMD=pkill -TERM -f "node dist/(api|worker)\.js" || true
# UPGRADE_START_CMD=mkdir -p logs && (nohup node dist/api.js >> logs/api.out 2>&1 &) && (nohup node dist/worker.js >> logs/worker.out 2>&1 &)
UPGRADE_STOP_CMD=
UPGRADE_START_CMD=
# 기동 후 새 버전 하트비트를 기다릴 인스턴스 수
UPGRADE_EXPECT_API=1
UPGRADE_EXPECT_WORKER=1
# 명령 실행, 중지 대기, 기동 대기 각각의 타임아웃(초)
UPGRADE_TIMEOUT_SEC=120
